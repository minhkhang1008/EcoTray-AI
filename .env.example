# Server only. Never use VITE_ for credentials.
IOT_SCHOOL_ID=ptnk
IOT_WRITE_TOKEN=
IOT_READ_TOKEN=
IOT_UID_HMAC_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional approved HTTPS origins for images already stored by AWS Lambda/S3.
IOT_IMAGE_ORIGINS=
# Profiles contain HMAC UID hashes only; never names or raw UIDs.
IOT_PROFILES_JSON=[]
# Local development only, disabled on Vercel. Resets on server restart.
IOT_LOCAL_MEMORY=false

# Public school identifiers; these are not credentials.
VITE_IOT_SCHOOL_ID=ptnk
VITE_SCHOOL_NAME=PTNK
