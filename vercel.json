{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/iot/*.mjs": {
      "maxDuration": 15
    },
    "api/ai/*.mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/)[^.]*)",
      "destination": "/index.html"
    }
  ]
}
